{
  "type" : "object",
  "description" : "Represents a checkout transaction created when the buyer submits the purchase.",
  "required" : [ "$schema" ],
  "properties" : {
    "$schema" : {
      "type" : "string",
      "format" : "uri",
      "description" : "Canonical URI of the immutable JSON Schema contract for this checkout transaction representation.",
      "readOnly" : true,
      "const" : "https://labs64.io/schemas/checkout/CheckoutTransaction/1.0.0.json",
      "default" : "https://labs64.io/schemas/checkout/CheckoutTransaction/1.0.0.json"
    },
    "id" : {
      "$ref" : "#/$defs/UUID",
      "readOnly" : true
    },
    "status" : {
      "$ref" : "#/$defs/CheckoutTransactionStatus",
      "readOnly" : true
    },
    "purchaseOrder" : {
      "$ref" : "https://labs64.io/schemas/checkout/PurchaseOrder/1.0.0.json"
    },
    "billingInfo" : {
      "$ref" : "#/$defs/BillingInfo"
    },
    "shippingInfo" : {
      "$ref" : "#/$defs/ShippingInfo"
    },
    "consents" : {
      "$ref" : "#/$defs/ConsentsMap"
    },
    "paymentMethod" : {
      "type" : "string",
      "description" : "Code of the selected payment method (e.g., STRIPE).",
      "example" : "STRIPE"
    },
    "createdAt" : {
      "type" : "string",
      "format" : "date-time",
      "readOnly" : true
    },
    "updatedAt" : {
      "type" : "string",
      "format" : "date-time",
      "readOnly" : true
    },
    "closedAt" : {
      "type" : "string",
      "format" : "date-time",
      "readOnly" : true
    }
  },
  "x-labs64" : {
    "schema" : {
      "object" : "CheckoutTransaction",
      "version" : "1.0.0"
    }
  },
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://labs64.io/schemas/checkout/CheckoutTransaction/1.0.0.json",
  "$defs" : {
    "UUID" : {
      "type" : "string",
      "format" : "uuid"
    },
    "CheckoutTransactionStatus" : {
      "type" : "string",
      "description" : "Represents the current state of a checkout transaction.",
      "enum" : [ "PENDING", "FAILED", "CANCELED", "COMPLETED" ]
    },
    "BillingInfo" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "firstName" : {
          "type" : "string",
          "description" : "First name of the person responsible for billing.",
          "maxLength" : 255,
          "example" : "John"
        },
        "lastName" : {
          "type" : "string",
          "description" : "Last name of the person responsible for billing.",
          "maxLength" : 255,
          "example" : "Doe"
        },
        "email" : {
          "type" : "string",
          "format" : "email",
          "description" : "Email address for billing purposes.",
          "maxLength" : 255,
          "example" : "john.doe@example.com"
        },
        "phone" : {
          "type" : "string",
          "description" : "Phone number for billing purposes.",
          "maxLength" : 50,
          "example" : "+1234567890"
        },
        "city" : {
          "type" : "string",
          "description" : "City of the billing address.",
          "maxLength" : 100,
          "example" : "New York"
        },
        "country" : {
          "type" : "string",
          "description" : "Country code of the billing address in ISO 3166-1 alpha-2 format.",
          "maxLength" : 2,
          "example" : "US"
        },
        "address1" : {
          "type" : "string",
          "description" : "Primary street address.",
          "maxLength" : 255,
          "example" : "123 Main St"
        },
        "address2" : {
          "type" : "string",
          "description" : "Secondary street address (optional).",
          "maxLength" : 255,
          "example" : "Apt 4B"
        },
        "postalCode" : {
          "type" : "string",
          "description" : "ZIP or postal code of the billing address.",
          "maxLength" : 20,
          "example" : "10001"
        },
        "state" : {
          "type" : "string",
          "description" : "State or region of the billing address.",
          "maxLength" : 50,
          "example" : "NY"
        },
        "vatId" : {
          "type" : "string",
          "description" : "Value Added Tax (VAT) identification number of the company for billing purposes \n            (e.g., USt-IdNr. in Germany). Required for B2B transactions in the EU.\n",
          "example" : "DE123456789"
        }
      }
    },
    "ShippingInfo" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "firstName" : {
          "type" : "string",
          "description" : "First name of the shipment recipient.",
          "maxLength" : 255,
          "example" : "John"
        },
        "lastName" : {
          "type" : "string",
          "description" : "Last name of the shipment recipient.",
          "maxLength" : 255,
          "example" : "Doe"
        },
        "phone" : {
          "type" : "string",
          "description" : "Recipient phone number (preferably in E.164 format; extensions may be included, e.g., \"ext. 123\").",
          "maxLength" : 50,
          "example" : "+15687985466"
        },
        "city" : {
          "type" : "string",
          "description" : "City of the shipping address.",
          "maxLength" : 100,
          "example" : "New York"
        },
        "country" : {
          "type" : "string",
          "description" : "Country code of the shipping address in ISO 3166-1 alpha-2 format.",
          "maxLength" : 2,
          "example" : "US"
        },
        "address1" : {
          "type" : "string",
          "description" : "Primary street address.",
          "maxLength" : 255,
          "example" : "123 Main St"
        },
        "address2" : {
          "type" : "string",
          "description" : "Secondary street address (optional).",
          "maxLength" : 255,
          "example" : "Apt 4B"
        },
        "postalCode" : {
          "type" : "string",
          "description" : "ZIP or postal code of the shipping address.",
          "maxLength" : 20,
          "example" : "10001"
        },
        "state" : {
          "type" : "string",
          "description" : "State or region of the shipping address.",
          "maxLength" : 50,
          "example" : "NY"
        }
      }
    },
    "ConsentsMap" : {
      "type" : "object",
      "description" : "Map of consent identifiers to the values accepted by the buyer during checkout. This map is provided by the client when calling checkout and is stored in the resulting Checkout Transaction.  Keys must match ConsentDefinition.id values defined on the associated  purchase order.\n",
      "additionalProperties" : {
        "type" : "boolean",
        "description" : "Indicates whether the buyer accepted the consent with the given identifier. true means accepted; false or a missing key means that the consent was not accepted.\n"
      },
      "example" : {
        "terms_of_service" : true,
        "privacy_policy" : true,
        "marketing_emails" : false
      }
    }
  }
}
